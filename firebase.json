{
  "hosting": [
    {
      "target": "default",
      "public": "public",
      "ignore": [
        "firebase.json",
        "**/node_modules/**"
      ],
      "redirects": [
        {
          "source": "/servicios.html",
          "destination": "/404.html",
          "type": 308
        },
        {
          "source": "/config.html",
          "destination": "/404.html",
          "type": 308
        },
        {
          "source": "/contacto.html",
          "destination": "/404.html",
          "type": 308
        }
      ],
      "rewrites": [
        {
          "source": "/redvet-app/assets/.env",
          "destination": "/redvet-app/assets/env"
        },
        {
          "source": "/redtpv-app/assets/.env",
          "destination": "/redtpv-app/assets/env"
        }
      ]
    },
    {
      "target": "redredsg",
      "public": "public",
      "ignore": [
        "firebase.json",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "/redvet-app/index.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, max-age=0, must-revalidate"
            }
          ]
        },
        {
          "source": "/redvet-app/flutter.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, max-age=0, must-revalidate"
            }
          ]
        },
        {
          "source": "/redvet-app/main.dart.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, max-age=0, must-revalidate"
            }
          ]
        },
        {
          "source": "/redvet-app/flutter_service_worker.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, max-age=0, must-revalidate"
            }
          ]
        }
      ],
      "redirects": [
        {
          "source": "/servicios.html",
          "destination": "/404.html",
          "type": 308
        },
        {
          "source": "/config.html",
          "destination": "/404.html",
          "type": 308
        },
        {
          "source": "/contacto.html",
          "destination": "/404.html",
          "type": 308
        }
      ],
      "rewrites": [
        {
          "source": "/redvet-app/assets/.env",
          "destination": "/redvet-app/assets/env"
        },
        {
          "source": "/redtpv-app/assets/.env",
          "destination": "/redtpv-app/assets/env"
        }
      ]
    }
  ]
}
